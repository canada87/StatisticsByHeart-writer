# Copy to docker/.env (git-ignored) for the compose CLI, or enter these as variables in the
# Portainer stack ("Environment variables" -> "Load variables from .env file" works too).
# Prefer alphanumeric secrets: openssl rand -hex 24

# --- required -----------------------------------------------------------------------------
SBH_DB_PASSWORD=change-me-with-openssl-rand-hex-24

# --- image --------------------------------------------------------------------------------
# Tag published to ghcr.io/canada87/statisticsbyheart-writer by the Release workflow.
# Pin a version (rollback = previous tag) or use "latest".
SBH_IMAGE_TAG=0.6.0

# --- network ------------------------------------------------------------------------------
# Host port published by sbh-api (the Nginx Proxy Manager Proxy Host forwards to <vm-ip>:<port>).
# 8742 is only a proposal: check it is free with  docker ps --format '{{.Ports}}'
SBH_HTTP_PORT=8742
# 0.0.0.0 = all host interfaces. To expose only on one address (e.g. the VM's Tailscale IP) put
# it here; that interface must be up when the container starts.
SBH_BIND_ADDR=0.0.0.0

# --- paths --------------------------------------------------------------------------------
# Local VM disk: the database lives in ${SBH_DATA_DIR}/db. NEVER on SMB/NAS.
SBH_DATA_DIR=/home/docker2404/StatisticsByHeart

# --- optional -----------------------------------------------------------------------------
# Comma-separated Android package names, most trusted first. When two apps write the same
# steps/sleep into Health Connect, the first listed wins on overlaps. Empty = automatic.
# Find the exact packages in the dashboard "Sync / Dati" page (per-source counts).
SBH_SOURCE_PRIORITY=

# Heart Points (heart-rate part). HRmax = SBH_HR_MAX if set, else 220 - age, where age is the year
# of the day computed minus SBH_BIRTH_YEAR. These are PERSONAL values: put them here / in the
# Portainer variables, never in the repository. With neither set only the step-cadence points
# are computed (the dashboard says so). After changing them run once:
#   docker exec <sbh-api> python -m app.cli recompute-heart-points
# Both are optional; leave empty to leave them unset.
SBH_BIRTH_YEAR=
SBH_HR_MAX=

# Alembic migrations on container start (set false if you prefer to run them by hand).
SBH_RUN_MIGRATIONS=true
