# Copy to docker/.env (git-ignored) for the compose CLI, or enter these as variables in the
# Portainer stack ("Environment variables" -> "Load variables from .env file" works too).
# Prefer alphanumeric secrets: openssl rand -hex 24

# --- required -----------------------------------------------------------------------------
SBH_DB_PASSWORD=change-me-with-openssl-rand-hex-24

# --- image --------------------------------------------------------------------------------
# Must match the tag you built:  docker build -f docker/Dockerfile -t statisticsbyheart-writer:0.1.0 .
SBH_IMAGE_TAG=0.1.0

# --- network ------------------------------------------------------------------------------
# Host port published by sbh-api (the NPM Proxy Host forwards to <tailscale-ip>:<port>).
# 8742 is only a proposal: check it is free with  docker ps --format '{{.Ports}}'
SBH_HTTP_PORT=8742
# 0.0.0.0 = all host interfaces. To expose only on the Tailscale address use 100.84.182.8
# (the VM's tailscale0 must be up when the container starts).
SBH_BIND_ADDR=0.0.0.0

# --- paths (confirmed by the user, PROJECT_GUIDE section 4) --------------------------------
# Local VM disk: DB lives in ${SBH_DATA_DIR}/db
SBH_DATA_DIR=/home/docker2404/StatisticsByHeart
# NAS share for pg_dump files (used only by the optional sbh-backup service)
SBH_BACKUP_DIR=/mnt/StatisticsByHeart

# --- optional -----------------------------------------------------------------------------
# Comma-separated Android package names, most trusted first. When two apps write the same
# steps/sleep into Health Connect, the first listed wins on overlaps. Empty = automatic.
# Find the exact packages in the Reader inventory screen / records `source.package`.
SBH_SOURCE_PRIORITY=

# Alembic migrations on container start (set false if you prefer to run them by hand).
SBH_RUN_MIGRATIONS=true

# Backup (sbh-backup runs only when COMPOSE_PROFILES contains "backup")
# COMPOSE_PROFILES=backup
SBH_BACKUP_HOUR=3
SBH_BACKUP_KEEP_DAYS=14
SBH_BACKUP_ON_START=false
